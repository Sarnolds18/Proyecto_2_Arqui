# Virtual Environments & Editor Files
.venv/
venv/
.DS_Store

# Python & Test Artifacts
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# FPGA Synthesis & Bitstream Artifacts (Yosys / nextpnr / icepack)
*.json
*.asc
*.bin
*.log
module_stats/

# Simulation Artifacts (Iverilog / GTKWave / Cocotb)
sim/sim
*.vcd
*.csv
# LibreLane (Proyecto 3): las corridas son pesadas (GDS, DEF, netlists).
# Se versionan solo los logs, reportes y metricas que cita el informe.
!flow/*/config.json
flow/*/runs/**
!flow/*/runs/**/
!flow/*/runs/**/*.log
!flow/*/runs/**/*.rpt
!flow/*/runs/**/metrics.json
!flow/*/runs/**/metrics.csv
!flow/*/runs/*/resolved.json
flow/*/runs/*/tmp/
# STA pre-PnR: solo summary.rpt (los reportes por corner no se usan y pesan decenas
# de MB). STA intermedios: solo los resumenes chicos (ws/wns/tns, skew, power).
flow/*/runs/*/*-openroad-staprepnr/*/
flow/*/runs/*/*-openroad-stamidpnr*/max.rpt
flow/*/runs/*/*-openroad-stamidpnr*/min.rpt
flow/*/runs/*/*-openroad-stamidpnr*/checks.rpt
flow/*/runs/*/*-openroad-stamidpnr*/openroad-stamidpnr*.log
# sta.log repite el contenido de los .rpt de cada corner.
flow/*/runs/**/sta.log
# Rutas detalladas post-PnR (max/min.rpt, ~10 MB c/u en el SoC): no se versionan.
# scripts/extract_critical_paths.py guarda las peores en <corrida>/rutas_criticas.rpt.
flow/*/runs/*/*-openroad-stapostpnr/*/max.rpt
flow/*/runs/*/*-openroad-stapostpnr/*/min.rpt
!results/*.csv
